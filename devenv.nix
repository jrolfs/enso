# Firefox build environment, adapted from Glide's flake.nix, which in turn was
# adapted from nixpkgs' pkgs/build-support/build-mozilla-mach/default.nix.
#
# Deliberate deviations from Glide's flake:
#   - MOZ_OBJDIR is not set. Surfer locates the object directory by globbing
#     engine/obj-*, so forcing engine/objdir breaks `surfer package`.
#   - Configure flags go to an untracked ./mozconfig rather than an env var.
#     Surfer concatenates configs/common, configs/<os>, ./mozconfig, then its
#     own internal block.
#   - npm/node 22 rather than pnpm/node 24, and python 3.11, to match Zen's
#     .nvmrc and .python-version.
{ pkgs, lib, ... }:

let
  inherit (lib) enableFeature optional optionals;
  inherit (pkgs) stdenv pkgsCross;

  # Track the LLVM version rustc was built against so cross-language LTO works.
  llvmPackages = pkgs.rustc.llvmPackages.override {
    bootBintoolsNoLibc = null;
    bootBintools = null;
  };
  llvmPackagesBuildBuild = pkgs.pkgsBuildBuild.rustc.llvmPackages.override {
    bootBintoolsNoLibc = null;
    bootBintools = null;
  };

  buildStdenv = pkgs.overrideCC llvmPackages.stdenv (
    llvmPackages.stdenv.cc.override { bintools = pkgs.stdenv.cc.bintools; }
  );

  # Firefox requires cbindgen >= 0.29.4; nixpkgs is on 0.29.2.
  rust-cbindgen = pkgs.rustPlatform.buildRustPackage (finalAttrs: {
    pname = "rust-cbindgen";
    version = "0.29.4";

    src = pkgs.fetchFromGitHub {
      owner = "mozilla";
      repo = "cbindgen";
      rev = "v${finalAttrs.version}";
      hash = "sha256-leeHOwpzXuzg2cTjXehBnCsS+dvU4eIIFtWKeCee20U=";
    };

    cargoHash = "sha256-f6YoDoiVoh0BVPYHFO1FsdI4OCsF+LY72QaD57StdIQ=";

    doCheck = false;
  });

  # RLBox sandboxing needs a wasm32 sysroot. Only C++ libs are linked here; the
  # compiler wrapper finds wasi libc and crt itself.
  wasiSysRoot = pkgs.runCommand "wasi-sysroot" { } ''
    mkdir -p $out/lib/wasm32-wasi
    for lib in ${pkgsCross.wasi32.llvmPackages.libcxx}/lib/*; do
      ln -s $lib $out/lib/wasm32-wasi
    done
  '';

  # Surfer invokes `gtar` by name when unpacking the Firefox tarball on macOS.
  gtar = pkgs.runCommand "gtar" { } ''
    mkdir -p $out/bin
    ln -s ${pkgs.gnutar}/bin/tar $out/bin/gtar
  '';

  isElfhackPlatform =
    stdenv.hostPlatform.isElf
    && (
      stdenv.hostPlatform.isi686
      || stdenv.hostPlatform.isx86_64
      || stdenv.hostPlatform.isAarch32
      || stdenv.hostPlatform.isAarch64
    );

  elfhackSupport =
    isElfhackPlatform && !(stdenv.hostPlatform.isMusl && stdenv.hostPlatform.isAarch64);

  # RLBox wasm sandboxing (graphite/ogg/hunspell) is off for local dev builds.
  # The Nix wasi sysroot links only libcxx, relying on the compiler wrapper to
  # supply wasi libc and crt, and configure rejects that with "Cannot find wasi
  # libraries or problem with the wasm linker". Fix the sysroot before shipping
  # a release build rather than carrying this forward.
  #
  # --with-wasi-sysroot and --without-wasm-sandboxed-libraries are mutually
  # exclusive: passing both fails with "--with-wasi-sysroot is not available in
  # this configuration".
  wasmSandbox = false;

  configureFlags =
    [
      "--with-libclang-path=${lib.getLib llvmPackagesBuildBuild.libclang}/lib"
    ]
    ++ (
      if wasmSandbox
      then [ "--with-wasi-sysroot=${wasiSysRoot}" ]
      else [ "--without-wasm-sandboxed-libraries" ]
    )
    ++ optional isElfhackPlatform (enableFeature elfhackSupport "elf-hack")
    ++ optionals (!stdenv.hostPlatform.isDarwin) [
      # macOS builds use bundled libraries: https://bugzilla.mozilla.org/show_bug.cgi?id=1776255
      "--enable-system-pixman"
      "--with-system-ffi"
      "--with-system-jpeg"
      "--with-system-libevent"
      "--with-system-libvpx"
      "--with-system-nspr"
      "--with-system-png"
      "--with-system-webp"
      "--with-system-zlib"
      "--with-onnx-runtime=${lib.getLib pkgs.onnxruntime}/lib"
    ];

  mozconfig = ''
    # Generated by devenv.nix on shell entry. Do not edit; do not commit.
    ${lib.concatMapStringsSep "\n" (flag: "ac_add_options " + flag) configureFlags}

    ac_add_options --with-ccache=sccache
    mk_add_options 'export RUSTC_WRAPPER=sccache'
  '';
in
{
  stdenv = buildStdenv;

  packages =
    with pkgs;
    [
      nodejs_22
      # Zen builds with npm, but Glide's build-ts/bundle scripts are pnpm
      # workspaces and we run them from the Glide checkout to generate
      # src/glide/**/dist and src/glide/bundled. No `.override { nodejs = ... }`
      # here as Glide's flake has: nixpkgs' pnpm is Rust-based now and takes no
      # such argument.
      pnpm
      python311
      rustc
      cargo
      rust-cbindgen
      rustPlatform.bindgenHook
      sccache

      autoconf
      gnum4
      llvmPackagesBuildBuild.bintools
      makeBinaryWrapper
      perl
      unzip
      which
      zip

      gtar
      gnutar

      # macOS ships BSD patch, which lacks --no-backup-if-mismatch and differs
      # in fuzzy-matching behaviour from what the vendor-branch script expects.
      gnupatch

      bzip2
      file
      libkrb5

      dump_syms
    ]
    ++ optionals stdenv.hostPlatform.isDarwin [
      rsync
      apple-sdk_26
      cups
    ]
    ++ optionals (!stdenv.hostPlatform.isDarwin) [
      pkg-config
      wrapGAppsHook3
      patchelf
      libGL
      libGLU
      libstartup_notification
      gcc.cc.lib
      dbus
      dbus-glib
      fontconfig
      freetype
      glib
      gtk3
      libffi
      libevent
      libjpeg
      libpng
      libvpx
      libwebp
      nspr
      pango
      pixman
      zlib
      alsa-lib
      libpulseaudio
      libxkbcommon
      libdrm
      xorgproto
      libx11
      libxcursor
      libxdamage
      libxext
      libxi
      libxrender
      libxt
      libxtst
    ]
    ++ optional stdenv.hostPlatform.isx86 nasm
    ++ optional (!stdenv.hostPlatform.isMusl) jemalloc;

  env = {
    # Without these the wrong cc from buildStdenv is picked up.
    HOST_CC = "${llvmPackagesBuildBuild.stdenv.cc}/bin/cc";
    HOST_CXX = "${llvmPackagesBuildBuild.stdenv.cc}/bin/c++";

    MOZ_NOSPAM = "1";

    WASM_CC = "${pkgsCross.wasi32.stdenv.cc}/bin/${pkgsCross.wasi32.stdenv.cc.targetPrefix}cc";
    WASM_CXX = "${pkgsCross.wasi32.stdenv.cc}/bin/${pkgsCross.wasi32.stdenv.cc.targetPrefix}c++";
  };

  enterShell = ''
    # AS=as in the environment breaks the build.
    # https://bugzilla.mozilla.org/show_bug.cgi?id=1497286
    unset AS

    export MOZBUILD_STATE_PATH="''${TMPDIR:-/tmp}/mozbuild"

    cat > "$DEVENV_ROOT/mozconfig" <<'EOF'
    ${mozconfig}
    EOF
  '';
}
